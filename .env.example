# ═══════════════════════════════════════════════════════════════
# IOC Hunt — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate secure keys with:
#   openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════

# ── App Version ──────────────────────────────────────────────
APP_VERSION=1.0.0

# ── Profiles (central, aggregator) ───────────────────────────
# Run both: COMPOSE_PROFILES=central,aggregator
# Run only aggregator: COMPOSE_PROFILES=aggregator
COMPOSE_PROFILES=central,aggregator

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=iochunt
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=iochunt_central

# ── Central Backend ──────────────────────────────────────────
CENTRAL_PORT=4002
CENTRAL_DATABASE_URL=postgres://iochunt:CHANGE_ME_use_openssl_rand_hex_32@db:5432/iochunt_central
CENTRAL_ENCRYPTION_KEY=CHANGE_ME_use_openssl_rand_hex_32
CENTRAL_API_KEY=CHANGE_ME_use_openssl_rand_hex_32
CENTRAL_FRONTEND_URL=https://72.62.241.39:8083

# ── Aggregator ───────────────────────────────────────────────
AGGREGATOR_NAME=branch-1
AGGREGATOR_PORT=4001
AGGREGATOR_DATABASE_URL=postgres://iochunt:CHANGE_ME_use_openssl_rand_hex_32@db:5432/iochunt_aggregator
AGGREGATOR_ENCRYPTION_KEY=CHANGE_ME_use_openssl_rand_hex_32
AGGREGATOR_API_KEY=CHANGE_ME_use_openssl_rand_hex_32
AGGREGATOR_SYSLOG_PORT=5520

# ── Nginx ────────────────────────────────────────────────────
NGINX_HTTP_PORT=8082
NGINX_HTTPS_PORT=8083

# ── SMTP (optional) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@iochunt.local

# ── Display ──────────────────────────────────────────────────
DISPLAY_TZ=Asia/Kolkata

# ── Future: Redis ────────────────────────────────────────────
# REDIS_URL=redis://redis:6379

# ── Future: Monitoring ───────────────────────────────────────
# PROMETHEUS_ENABLED=false
# GRAFANA_ENABLED=false
