# ═══════════════════════════════════════════════════════════════
# IOC Hunt — Unified Security Platform Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env:
#   cp .env.example .env
#
# Generate random 32-byte hex keys with:
#   openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════

# ── Instance Role & Multi-Tenancy ─────────────────────────────
# Options: central_server | aggregator
INSTANCE_MODE=central_server
TENANT_ID=default
INSTANCE_NAME=IOC Hunt Central Command Hub
APP_VERSION=2.0.0

# ── Server Port ───────────────────────────────────────────────
PORT=4001

# ── Environment & Security ────────────────────────────────────
NODE_ENV=production
USE_HTTPS=true

# ── PostgreSQL Database ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=iochunt_db
DATABASE_URL=postgres://postgres:generate_strong_password_here@db:5432/iochunt_db
# Set DATABASE_SSL=true only when connecting to an external database requiring SSL (e.g. AWS RDS)
DATABASE_SSL=false

# ── Security & Cryptography ───────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32
# Endpoint agent and aggregator ingestion key (must match on all reporting agents)
API_KEY=generate_random_secure_token_for_agents

# ── Networking & CORS ─────────────────────────────────────────
# In production, set to your exact domain, e.g. https://iochunt.yourdomain.com
FRONTEND_URL=*
DISPLAY_TZ=Asia/Kolkata
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── SMTP Email Notifications (Optional) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@iochunt.local
