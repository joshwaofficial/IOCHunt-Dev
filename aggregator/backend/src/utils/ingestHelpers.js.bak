const THEME_TOGGLE_BTN = `
<button id="themeToggle" onclick="toggleTheme()"
  title="Toggle theme (Alt+T)"
  style="background:var(--surface2);border:1px solid var(--border);
         color:var(--muted2);border-radius:8px;width:34px;height:34px;
         cursor:pointer;font-size:16px;display:flex;align-items:center;
         justify-content:center;flex-shrink:0">
  <span id="themeIcon">🌙</span>
</button>`;

const THEME_SCRIPT = `<script>
var _theme = localStorage.getItem('iochunt-theme') || 'dark';

// Keep the .light class in sync with data-theme on load
if (_theme === 'light') document.documentElement.classList.add('light');

function _applyTheme(t){
  _theme = t;
  document.documentElement.setAttribute('data-theme', t);
  if (t === 'light') {
    document.documentElement.classList.add('light');
  } else {
    document.documentElement.classList.remove('light');
  }
  var ic = document.getElementById('themeIcon');
  if(ic) ic.textContent = t==='dark' ? 'light_mode' : 'dark_mode';
  localStorage.setItem('iochunt-theme', t);
}
function toggleNotifications() {
  var p = document.getElementById('notifPopup');
  if(p.style.display==='none' || p.style.display===''){
    p.style.display='flex';
    var dot = document.getElementById('notifCount');
    if(dot) { dot.style.display='none'; dot.textContent='0'; }
  } else {
    p.style.display='none';
  }
}

function addNotification(msg) {
  var list = document.getElementById('notifList');
  var noNotifs = document.getElementById('noNotifs');
  if (noNotifs) noNotifs.style.display = 'none';
  var item = document.createElement('div');
  item.style.padding = '12px 16px';
  item.style.borderBottom = '1px solid var(--border)';
  item.style.fontSize = '12px';
  item.style.color = 'var(--text)';
  item.style.fontFamily = 'var(--sans)';
  var time = new Date().toLocaleTimeString();
  item.innerHTML = '<div style="font-size:10px;color:var(--muted);margin-bottom:4px">' + time + '</div>' + msg;
  list.insertBefore(item, list.firstChild);
  var dot = document.getElementById('notifCount');
  if(dot) {
    dot.style.display = 'flex';
    dot.textContent = parseInt(dot.textContent || '0') + 1;
  }
}
function toggleTheme(){
  _applyTheme(_theme==='dark'?'light':'dark');
  // Refresh charts so they pick up new colors
  if(typeof chartTimeline  !== 'undefined' && chartTimeline)  { chartTimeline.destroy();  chartTimeline=null;  }
  if(typeof chartCategory  !== 'undefined' && chartCategory)  { chartCategory.destroy();  chartCategory=null;  }
  if(typeof chartSeverity  !== 'undefined' && chartSeverity)  { chartSeverity.destroy();  chartSeverity=null;  }
  if(typeof statsData !== 'undefined' && statsData) {
    renderTimeline(); renderCategoryChart(); renderSeverityChart();
  }
}
</script>`;

